# ==========================================
# JalWatch Delhi — Environment Configuration
# ==========================================

# Application Environment
APP_ENV=local
DEBUG=True

# Database Configuration (SQLite local, PostgreSQL in Cloud)
DATABASE_URL=sqlite:///./jalwatch.db

# Frontend CORS (comma separated origins)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ==========================================
# LLM & AI Agent Configuration (LangChain)
# ==========================================
# Choose your active provider: "groq" or "google"
LLM_PROVIDER=groq

# 1. Groq Configuration (ChatGroq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 2. Google Gemini Configuration (ChatGoogleGenerativeAI)
GOOGLE_API_KEY= 
GOOGLE_MODEL=gemini-1.5-flash

# ==========================================
# Admin Portal Authentication
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@jalwatch2026

# ==========================================
# AWS Cloud Deployment Target (Phase 7)
# ==========================================
AWS_REGION=ap-south-1
S3_BUCKET=
